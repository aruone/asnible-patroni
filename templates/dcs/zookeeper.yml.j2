zookeeper:
  hosts: {{ "%s\n" |format(patroni_zookeeper_hosts |d('127.0.0.1:2181', true)) }}
  use_ssl: {{ patroni_zookeeper_use_ssl|d('false') }}
  {% if patroni_zookeeper_cacert|d(None, true) %}
  cacert: {{ patroni_zookeeper_cacert }}
  {% endif %}
  {% if patroni_zookeeper_cert|d(None, true) %}
  cert: {{ patroni_zookeeper_cert }}
  {% endif %}
  {% if patroni_zookeeper_key|d(None, true) %}
  key: {{ patroni_zookeeper_key }}
  {% endif %}
  {% if patroni_zookeeper_key_password|d(None, true) %}
  key_password: {{ patroni_zookeeper_key_password }}
  {% endif %}
  {% if patroni_zookeeper_verify|d(None, true) %}
  verify: {{ patroni_zookeeper_verify }}
  {% endif %}
  {% if patroni_zookeeper_set_acls|d(None, true) %}
  set_acls: {{ patroni_zookeeper_set_acls }}
  {% endif %}
  {% if patroni_zookeeper_auth_data|d(None, true) %}
  auth_data: {{ patroni_zookeeper_auth_data }}
  {% endif %}
  